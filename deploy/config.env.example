# webnovel-mcp 运行配置（部署时复制成 config.env，权限 600）
# 书库根目录：所有书都建在这下面，服务不会读写这个目录之外的任何文件
WEBNOVEL_ROOT=/data/data/com.termux/files/home/webnovel-mcp/books
# 监听端口（vivo 上 8000/8100/8200/8300/8400/8500 已占用）
WEBNOVEL_PORT=8600
# 局域网可达；只给家里的 WorkBuddy 用，不要映射到公网
WEBNOVEL_BIND=0.0.0.0
# 访问令牌：WorkBuddy 侧要用 Authorization: Bearer <token>（部署脚本自动生成）
WEBNOVEL_TOKEN=CHANGE_ME
# 单次请求体上限（字节）；提交整章正文用得到，32MB 足够
WEBNOVEL_MAX_BODY=33554432
